{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/group-tours", "destination": "/groepsreizen", "permanent": true },
    { "source": "/individual-tours", "destination": "/individuele-reizen", "permanent": true },
    { "source": "/tailor-made", "destination": "/op-maat", "permanent": true },
    { "source": "/destinations", "destination": "/bestemmingen", "permanent": true },
    { "source": "/experience", "destination": "/de-ervaring", "permanent": true },
    { "source": "/faq", "destination": "/veelgestelde-vragen", "permanent": true },
    { "source": "/tours/:slug", "destination": "/reizen/:slug", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/media/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
